# ============================================
# VoiceCV Environment Variables
# ============================================
# Copy this file to .env.local and fill in your keys.
# Never commit .env.local to git (it's in .gitignore).

# Google Gemini API Key (REQUIRED)
# Get your free key at: https://aistudio.google.com/apikey
# Used for: AI document generation, resume parsing, cover letters,
#           LinkedIn import, ATS optimization, career path suggestions,
#           interview simulator
#GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# OTHER API KEYS (Future Features)
# ============================================

# OpenAI API Key (Optional - for future GPT features)
# OPENAI_API_KEY=

# ElevenLabs API Key (Optional - for future voice synthesis)
# ELEVENLABS_API_KEY=

# Supabase (REQUIRED for Vercel deployment)
# Get your credentials at: https://supabase.com/dashboard
# Used for: Authentication, database, theme persistence, profile management
# SUPABASE_URL=your_supabase_project_url
# SUPABASE_ANON_KEY=your_supabase_anon_key

# Firebase (Optional - for future auth/firestore)
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
